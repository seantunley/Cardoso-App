# Cardoso Dev Environment
# Used for testing on Windows alongside the installed production service.
# Run with: npm run dev:local
#
# IMPORTANT: Fill in ENCRYPTION_KEY and SESSION_SECRET to match your production .env
# so the dev instance can open the same database.

PORT=3002

# Copy these from your production .env — must match or the DB passwords won't decrypt
SESSION_SECRET=your_session_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Site identity (can leave as-is for local dev)
SITE_ID=dev-local
SITE_SLUG=dev
SITE_NAME=Dev

REPORTING_TOKEN=dev_token

HUB_MODE=false
HUB_SITES=[]

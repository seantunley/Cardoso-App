{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,

    // noImplicitAny is off because tsc with checkJs:true pulls in every
    // transitively-imported .jsx, and the React component layer is
    // entirely untyped today. Disabling implicit-any keeps the goal
    // narrow: catch SHAPE MISMATCHES between API responses (typed in
    // src/types/api-rows.d.ts) and the pages that read them. Adopting
    // implicit-any:true site-wide is a separate, bottom-up task
    // (start at src/components/ui/) tracked in memory.
    "noImplicitAny": false
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/db/index.js",
    "src/lib/app-params.js",
    "src/lib/clientLog.js",
    "src/lib/creditLogic.js",
    "src/lib/dates.js",
    "src/lib/evalFlagRules.js",
    "src/lib/errorDescribe.js",
    "src/lib/errorLog.js",
    "src/lib/humanizeApiError.js",
    "src/lib/isoWeek.js",
    "src/lib/manualFlagMessages.js",
    "src/lib/permissions.js",
    "src/lib/query-client.js",
    "src/lib/retention.js",
    "src/lib/useColorScheme.js",
    "src/lib/useColumnWidths.js",
    "src/lib/utils.js",
    "src/utils/index.ts",
    "src/api/apiClient.js",
    "src/pages/Users.jsx",
    "src/pages/Collections.jsx",
    "src/pages/CustomerBalances.jsx",
    "src/pages/Inventory.jsx",
    "src/pages/SalesCommission.jsx"
  ],
  "exclude": ["node_modules", "dist"]
}

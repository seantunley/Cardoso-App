# Cardoso App - Environment Variables
# Copy this to .env and fill in your values

# Server port (default: 3001 for prod, use 3002 for dev)
PORT=3001

# Session secret - generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret_here

# Encryption key for stored SQL passwords - generate with: openssl rand -hex 32
# WARNING: If you change this, all saved connection passwords will need to be re-entered
ENCRYPTION_KEY=your_encryption_key_here

# ── Multi-site federation ──────────────────────────────────────────────────────
# Unique identifier for this site (UUID recommended)
SITE_ID=generate-a-uuid-here

# Short slug for this site (e.g. jhb, pta, ermelo)
SITE_SLUG=local

# Human-readable display name (e.g. Johannesburg, Pretoria)
SITE_NAME=Local

# Token for the read-only reporting API — generate with: openssl rand -hex 32
# Set this on each site. The hub must send this in the X-Reporting-Token header.
REPORTING_TOKEN=your_reporting_token_here

# ---- Hub ETL (Head Office only) ----
# Set HUB_MODE=true on the head office instance only.
HUB_MODE=false

# JSON array of sites to aggregate. Each site needs id, slug, name, url, token.
# Example:
# HUB_SITES=[{"id":"uuid1","slug":"ermelo","name":"Ermelo","url":"http://192.168.0.x:3001","token":"site_reporting_token"},{"id":"uuid2","slug":"jhb","name":"Johannesburg","url":"http://192.168.0.y:3001","token":"site_reporting_token"}]
HUB_SITES=[]

# Hub-only Postgres foundation scaffold (Phase 2)
# Disabled by default. When enabled, config is validated for hub instances only,
# but SQLite remains the active live path until a later cutover.
HUB_POSTGRES_ENABLED=false
# HUB_POSTGRES_URL=postgres://cardoso:change_me@localhost:5432/cardoso_hub
HUB_POSTGRES_SCHEMA=public
HUB_POSTGRES_SSL=false
HUB_POSTGRES_APPLICATION_NAME=cardoso-hub
HUB_POSTGRES_POOL_MIN=0
HUB_POSTGRES_POOL_MAX=10

# Hub redirect — URL to send hub users to when they log in at a site instance
# HUB_REDIRECT_URL=http://100.84.112.80:5173

# Default password for new users (they are forced to change on first login)
# DEFAULT_USER_PASSWORD=Cardoso@2026
